# Public Supabase project URL from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (safe for browser use when RLS is configured).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public HTTPS origin of the deployed NUMPA FastAPI service.
NEXT_PUBLIC_NUMPA_API_URL=https://your-api-service.onrender.com
